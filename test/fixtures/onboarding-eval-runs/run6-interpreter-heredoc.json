"/bin/zsh -lc \"python3 - <<'PY'\nimport subprocess,json\ndef run(*args):\n r=subprocess.run(['storybloq',*args],text=True,capture_output=True)\n print(r.stdout.strip())\n if r.returncode: raise SystemExit(r.stderr or r.stdout)\ntest='cd backend && python -m pytest && cd ../frontend && npm test'\nrun('config','set-overrides','--json',json.dumps({'stages':{\n 'WRITE_TESTS':{'enabled':True,'command':test,'onExhaustion':'plan'},\n 'TEST':{'enabled':True,'command':test},\n 'BUILD':{'enabled':True,'command':'cd frontend && npm run build'},\n 'VERIFY':{'enabled':False}}}))\nfor pid,name,label,description,after in [\n ('foundation','Foundation','PHASE 1','Confirm the queue contract and establish runnable development and test tooling.','p0'),\n ('queue','Queue workflow','PHASE 2','Volunteers add visitors; repairers take and finish repairs using agreed queue rules.','foundation'),\n ('board','Live board','PHASE 3','Visitors see waiting and active repairs, refreshed automatically; owner accepts the full journey.','queue')]:\n run('phase','create','--id',pid,'--name',name,'--label',label,'--description',description,'--after',after)\nPY\""
