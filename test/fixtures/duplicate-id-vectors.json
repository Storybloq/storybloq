    { "name": "three issue files, one id", "dir": "issues", "files": [{ "name": "ISS-001.json", "id": "ISS-001" }, { "name": "a.json", "id": "ISS-001" }, { "name": "b.json", "id": "ISS-001" }], "duplicates": [{ "id": "ISS-001", "files": [".story/issues/ISS-001.json", ".story/issues/a.json", ".story/issues/b.json"] }], "writesRefused": true },
    { "name": "two note files, one id", "dir": "notes", "files": [{ "name": "N-001.json", "id": "N-001" }, { "name": "N-001 copy.json", "id": "N-001" }], "duplicates": [{ "id": "N-001", "files": [".story/notes/N-001 copy.json", ".story/notes/N-001.json"] }], "writesRefused": true },
    { "name": "two lesson files, one id", "dir": "lessons", "files": [{ "name": "L-001.json", "id": "L-001" }, { "name": "b.json", "id": "L-001" }], "duplicates": [{ "id": "L-001", "files": [".story/lessons/L-001.json", ".story/lessons/b.json"] }], "writesRefused": true },
    { "name": "one misnamed file, no duplicate", "dir": "tickets", "files": [{ "name": "old.json", "id": "T-001" }], "duplicates": [], "writesRefused": false },
    { "name": "hash pair sharing a display id", "dir": "tickets", "files": [{ "name": "t-0000000000000001.json", "id": "t-0000000000000001", "displayId": "T-001" }, { "name": "t-0000000000000002.json", "id": "t-0000000000000002", "displayId": "T-001" }], "duplicates": [], "writesRefused": false },
    { "name": "legacy and hash sharing a display id", "dir": "tickets", "files": [{ "name": "T-001.json", "id": "T-001" }, { "name": "t-0000000000000002.json", "id": "t-0000000000000002", "displayId": "T-001" }], "duplicates": [], "writesRefused": false }
  ]
